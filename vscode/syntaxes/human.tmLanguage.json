{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "human",
  "scopeName": "source.human",
  "patterns": [
    { "include": "#comment" },
    { "include": "#requirement" },
    { "include": "#entity" },
    { "include": "#state" },
    { "include": "#service" },
    { "include": "#bare-prefix" },
    { "include": "#arrow" },
    { "include": "#plus" },
    { "include": "#equals" },
    { "include": "#bullet" },
    { "include": "#dash" },
    { "include": "#word" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.double-slash.human",
      "match": "(?:^|(?<=\\s))//.*$"
    },
    "requirement": {
      "name": "markup.heading.human",
      "begin": "^#",
      "end": "(?=(?:^|(?<=\\s))//)|$"
    },
    "entity": {
      "name": "entity.name.type.human",
      "match": "(?<![\\w@$?#])\\$\\w+"
    },
    "state": {
      "name": "variable.other.constant.human",
      "match": "(?<![\\w@$?#])\\?\\w+"
    },
    "service": {
      "name": "entity.name.function.human",
      "match": "(?<![\\w@$?#])@\\w+"
    },
    "bare-prefix": {
      "name": "punctuation.definition.prefix.human",
      "match": "(?<![\\w@$?#])[@$?#](?![\\w])"
    },
    "arrow": {
      "name": "keyword.operator.arrow.human",
      "match": "(?<=\\s)->(?=\\s|$)"
    },
    "plus": {
      "name": "keyword.operator.plus.human",
      "match": "(?<=\\s)\\+(?=\\s|$)"
    },
    "equals": {
      "name": "keyword.operator.equals.human",
      "match": "(?<=\\s)==(?=\\s|$)"
    },
    "bullet": {
      "match": "^([ ]*)(-)(?=\\s|$)",
      "captures": { "2": { "name": "punctuation.definition.list.begin.human" } }
    },
    "dash": {
      "name": "punctuation.definition.dash.human",
      "match": "(?<=\\s)-(?=\\s|$)"
    },
    "word": {
      "name": "string.unquoted.word.human",
      "match": "(?<!\\S)(?!->(?=\\s|$)|==(?=\\s|$)|\\+(?=\\s|$)|-(?=\\s|$))[^\\s]+"
    }
  }
}
