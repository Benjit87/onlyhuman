{
  "name": "onlyhuman-vscode",
  "displayName": "onlyhuman",
  "description": "Highlighting, linting and go-to-definition for onlyhuman *.human and *.bot spec files",
  "version": "0.4.0",
  "publisher": "benjit87",
  "repository": {
    "type": "git",
    "url": "https://github.com/Benjit87/onlyhuman.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "onlyhuman",
    "spec",
    "human",
    "bot"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:human",
    "onLanguage:onlyhuman-robot"
  ],
  "contributes": {
    "languages": [
      {
        "id": "human",
        "extensions": [
          ".human"
        ],
        "aliases": [
          "human"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "onlyhuman-robot",
        "extensions": [
          ".bot"
        ],
        "aliases": [
          "onlyhuman robot"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "human",
        "scopeName": "source.human",
        "path": "./syntaxes/human.tmLanguage.json"
      },
      {
        "language": "onlyhuman-robot",
        "scopeName": "source.human.robot",
        "path": "./syntaxes/robot.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "package": "vsce package"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "@vscode/vsce": "^3.0.0",
    "vscode-languageclient": "^9.0.1"
  }
}
